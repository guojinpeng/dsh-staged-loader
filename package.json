{
  "name": "@guojinpeng/dsh-staged-loader",
  "version": "0.1.0",
  "type": "module",
  "description": "Start DSH with the core bundles only, then enable third-party bundles after the page is ready and show the progress in the bottom-right corner.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "startup"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guojinpeng/dsh-staged-loader.git"
  },
  "bugs": {
    "url": "https://github.com/guojinpeng/dsh-staged-loader/issues"
  },
  "homepage": "https://github.com/guojinpeng/dsh-staged-loader",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "pack:release": "npm pack"
  },
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh": ">=0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  }
}
